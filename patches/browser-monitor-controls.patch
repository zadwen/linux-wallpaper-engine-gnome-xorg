new file mode 100644
index 0000000..1d7cca5
--- /dev/null
+++ b/scripts/package-monitors.mjs
@@ -0,0 +1,24 @@
+import fs from 'node:fs/promises'
+import path from 'node:path'
+import os from 'node:os'
+import { extractAll, createPackageWithOptions } from '@electron/asar'
+const [original, destination] = process.argv.slice(2)
+if (!original || !destination) throw new Error('Usage: node scripts/package-monitors.mjs ORIGINAL_INSTALL NEW_DIRECTORY')
+await fs.mkdir(destination, {recursive: false})
+const temporary = await fs.mkdtemp(path.join(os.tmpdir(), 'we-monitor-package-'))
+try {
+  for (const entry of await fs.readdir(original)) {
+    if (entry === 'resources') continue
+    const source = path.join(original, entry), target = path.join(destination, entry)
+    if (entry === 'linux-wallpaper-engine') await fs.copyFile(source, target)
+    else await fs.symlink(source, target)
+  }
+  await fs.chmod(path.join(destination, 'linux-wallpaper-engine'), 0o755)
+  const resources = path.join(destination, 'resources'); await fs.mkdir(resources)
+  await fs.symlink(path.join(original, 'resources/assets'), path.join(resources, 'assets'))
+  extractAll(path.join(original, 'resources/app.asar'), temporary)
+  await fs.rm(path.join(temporary, '.vite'), {recursive: true, force: true})
+  await fs.cp('.vite', path.join(temporary, '.vite'), {recursive: true})
+  await createPackageWithOptions(temporary, path.join(resources, 'app.asar'), {unpack: '**/*.{node,so,dll,dylib}'})
+  console.log('Packaged monitor controls at ' + destination)
+} finally {await fs.rm(temporary, {recursive: true, force: true})}
diff --git a/src/main/services/monitor-preferences.test.ts b/src/main/services/monitor-preferences.test.ts
new file mode 100644
index 0000000..7939ba1
--- /dev/null
+++ b/src/main/services/monitor-preferences.test.ts
@@ -0,0 +1,54 @@
+import { beforeEach, afterEach, expect, test, vi } from 'vitest'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+const runtime = vi.hoisted(() => ({directory: ''}))
+import {getMonitorPreferences, saveMonitorPreferences, getFraming, saveFraming, wallpaperGroupKey, knownDisplays, savedMonitorSelections, clearMonitorSelection, monitorApplyOptions} from './monitor-preferences'
+beforeEach(() => {runtime.directory = fs.mkdtempSync(path.join(os.tmpdir(), 'we-monitor-test-')); vi.stubEnv('XDG_CONFIG_HOME', runtime.directory)})
+afterEach(() => {fs.rmSync(runtime.directory, {recursive: true, force: true}); vi.unstubAllEnvs()})
+test('the same wallpaper keeps independent monitor settings and properties', () => {
+  saveMonitorPreferences('HDMI-0', {backgroundId: 'same', fps: 30, silent: true, monitorSpecific: true, customProperties: {color: 'red'}})
+  saveMonitorPreferences('DP-0', {backgroundId: 'same', fps: 60, silent: false, monitorSpecific: true, customProperties: {color: 'blue'}})
+  expect(getMonitorPreferences('HDMI-0', 'same')).toMatchObject({fps: 30, silent: true, customProperties: {color: 'red'}})
+  expect(getMonitorPreferences('DP-0', 'same')).toMatchObject({fps: 60, silent: false, customProperties: {color: 'blue'}})
+  saveMonitorPreferences('DP-0', {backgroundId: 'other', fps: 45, customProperties: {text: 'second'}})
+  expect(getMonitorPreferences('DP-0', 'same').customProperties).toEqual({color: 'blue'})
+})
+test('framing updates preserve the other monitor', () => {
+  saveFraming('HDMI-0', {x: 10, y: 20, zoom: 150})
+  saveFraming('DP-0', {x: 90, y: 80, zoom: 200})
+  expect(getFraming('HDMI-0')).toEqual({x: 10, y: 20, zoom: 150})
+  expect(getFraming('DP-0')).toEqual({x: 90, y: 80, zoom: 200})
+})
+test('restart grouping separates different monitor options but ignores screen names and key order', () => {
+  expect(wallpaperGroupKey({backgroundId:'same',screen:'A',fps:30})).not.toBe(wallpaperGroupKey({backgroundId:'same',screen:'B',fps:60}))
+  expect(wallpaperGroupKey({backgroundId:'same',screen:'A',customProperties:{a:'1',b:'2'}})).toBe(wallpaperGroupKey({screen:'B',customProperties:{b:'2',a:'1'},backgroundId:'same'}))
+})
+test('malformed preferences are reported and preserved', () => {
+  fs.mkdirSync(path.join(runtime.directory, 'wallpaper-engine'))
+  const file = path.join(runtime.directory, 'wallpaper-engine', 'monitor-settings.json')
+  fs.writeFileSync(file, '{bad data')
+  expect(() => saveMonitorPreferences('A', {backgroundId:'same',fps:60})).toThrow()
+  expect(fs.readFileSync(file,'utf8')).toBe('{bad data')
+})
+
+test('disconnected monitors keep their number and saved settings, while Stop prevents restoration', () => {
+  const display = {id:'HDMI-0',name:'HDMI-0',width:3840,height:2160,x:0,y:0,resolution:'3840x2160',refreshRate:60,primary:true,connected:true,degraded:false}
+  const saved = {'HDMI-0':{backgroundId:'one',fps:30},'DP-0':{backgroundId:'two',fps:60}}
+  const first = knownDisplays([display],saved)
+  expect(first.map(d => [d.name,d.number,d.connected])).toEqual([['HDMI-0',1,true],['DP-0',2,false]])
+  const reconnected = knownDisplays([{...display,id:'DP-0',name:'DP-0'}],saved)
+  expect(reconnected.find(d => d.name === 'DP-0')?.number).toBe(2)
+  expect(savedMonitorSelections()['DP-0']).toMatchObject({backgroundId:'two',fps:60})
+  clearMonitorSelection(['DP-0'])
+  expect(savedMonitorSelections()['DP-0']).toBeUndefined()
+  expect(getMonitorPreferences('DP-0','two').fps).toBe(60)
+})
+
+test('All monitors applies one wallpaper with independent performance and custom properties', () => {
+  saveMonitorPreferences('A',{backgroundId:'same',fps:30,silent:true,customProperties:{wolf:'1'}})
+  saveMonitorPreferences('B',{backgroundId:'same',fps:60,silent:false,customProperties:{wolf:'0'}})
+  expect(monitorApplyOptions({backgroundId:'same',fps:90},'A')).toMatchObject({backgroundId:'same',fps:30,silent:true,customProperties:{wolf:'1'}})
+  expect(monitorApplyOptions({backgroundId:'same',fps:90},'B')).toMatchObject({backgroundId:'same',fps:60,silent:false,customProperties:{wolf:'0'}})
+  expect(monitorApplyOptions({backgroundId:'new'},'B')).toMatchObject({backgroundId:'new',fps:60})
+})
diff --git a/src/main/services/monitor-preferences.ts b/src/main/services/monitor-preferences.ts
new file mode 100644
index 0000000..139f81d
--- /dev/null
+++ b/src/main/services/monitor-preferences.ts
@@ -0,0 +1,70 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import os from 'node:os'
+import type { Display } from './display'
+import type { ApplyWallpaperOptions } from '../../shared/constants/wallpaper'
+
+type Preferences = { selectedWallpaper?: string; options?: Partial<ApplyWallpaperOptions>; wallpapers?: Record<string, Record<string, string>> }
+function file(name: string) { return path.join(process.env.XDG_CONFIG_HOME || path.join(os.homedir(), '.config'), 'wallpaper-engine', name) }
+function read(name: string): Record<string, any> {
+  try { const value = JSON.parse(fs.readFileSync(file(name), 'utf8')); if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid monitor settings'); return value }
+  catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return {}; throw error }
+}
+function write(name: string, value: object) {
+  const destination = file(name); fs.mkdirSync(path.dirname(destination), { recursive: true })
+  const temporary = destination + '.' + process.pid + '.tmp'
+  fs.writeFileSync(temporary, JSON.stringify(value, null, 2) + '\n'); fs.renameSync(temporary, destination)
+}
+export function getMonitorPreferences(screen: string, wallpaper: string): Partial<ApplyWallpaperOptions> {
+  const saved: Preferences = read('monitor-settings.json')[screen] ?? {}
+  return { ...saved.options, ...(saved.selectedWallpaper ? {backgroundId: saved.selectedWallpaper} : {}), ...(saved.wallpapers?.[wallpaper] ? {customProperties: saved.wallpapers[wallpaper]} : {}) }
+}
+export function saveMonitorPreferences(screen: string, options: ApplyWallpaperOptions) {
+  const all = read('monitor-settings.json'); const saved: Preferences = all[screen] ?? {}
+  const { backgroundId, screen: _screen, customProperties, windowed: _windowed, ...preferences } = options
+  all[screen] = { selectedWallpaper: backgroundId, options: preferences, wallpapers: { ...saved.wallpapers, [backgroundId]: customProperties ?? {} } }
+  write('monitor-settings.json', all)
+}
+export function getFraming(screen: string) { return { x: 50, y: 50, zoom: 100, ...read('positions.json')[screen] } as {x: number; y: number; zoom: number} }
+export function saveFraming(screen: string, framing: {x: number; y: number; zoom: number}) {
+  write('positions.json', { ...read('positions.json'), [screen]: framing }); return framing
+}
+export function wallpaperGroupKey(options: ApplyWallpaperOptions) {
+  const { screen: _screen, ...rest } = options
+  return JSON.stringify(rest, (_key, value) => value && typeof value === 'object' && !Array.isArray(value)
+    ? Object.fromEntries(Object.entries(value).sort(([a], [b]) => a.localeCompare(b))) : value)
+}
+
+export function knownDisplays(connected: Display[], saved: Record<string, ApplyWallpaperOptions>) {
+  const preferences = read('monitor-settings.json')
+  for (const [screen, options] of Object.entries(saved)) if (screen !== 'default' && !Object.hasOwn(preferences, screen)) saveMonitorPreferences(screen, options)
+  const records = read('monitor-displays.json') as Record<string, Display & {number: number}>
+  let next = Math.max(0, ...Object.values(records).map(d => d.number || 0)) + 1
+  for (const display of [...connected].sort((a,b) => Number(b.primary)-Number(a.primary) || a.name.localeCompare(b.name))) {
+    records[display.name] = {...display, number: records[display.name]?.number ?? next++}
+  }
+  for (const name of Object.keys(saved)) if (name !== 'default' && !records[name]) {
+    records[name] = {id:name,name,resolution:'Disconnected',width:1920,height:1080,x:0,y:0,refreshRate:60,primary:false,connected:false,degraded:false,number:next++}
+  }
+  write('monitor-displays.json', records)
+  return Object.values(records).sort((a,b) => a.number-b.number).map(display => ({
+    ...display, connected: connected.some(d => d.name === display.name),
+    savedOptions: {...saved[display.name], ...getMonitorPreferences(display.name, saved[display.name]?.backgroundId ?? '')},
+  }))
+}
+
+export function savedMonitorSelections(): Record<string, ApplyWallpaperOptions> {
+  return Object.fromEntries(Object.entries(read('monitor-settings.json') as Record<string, Preferences>)
+    .filter(([, saved]) => saved.selectedWallpaper)
+    .map(([screen, saved]) => [screen, {...saved.options, screen, backgroundId: saved.selectedWallpaper!, customProperties: saved.wallpapers?.[saved.selectedWallpaper!]}]))
+}
+export function clearMonitorSelection(screens?: string[]) {
+  const all = read('monitor-settings.json')
+  for (const screen of screens ?? Object.keys(all)) if (all[screen]) delete all[screen].selectedWallpaper
+  write('monitor-settings.json', all)
+}
+
+export function monitorApplyOptions(options: ApplyWallpaperOptions, screen: string): ApplyWallpaperOptions {
+  const saved = options.screen ? {} : getMonitorPreferences(screen, options.backgroundId)
+  return {...options, ...saved, backgroundId: options.backgroundId, screen, monitorSpecific: saved.monitorSpecific ?? options.monitorSpecific ?? false}
+}
