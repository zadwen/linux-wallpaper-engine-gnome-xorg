diff --git a/src/renderer/hooks/use-monitor-selection.ts b/src/renderer/hooks/use-monitor-selection.ts
new file mode 100644
index 0000000..6eb7fc7
--- /dev/null
+++ b/src/renderer/hooks/use-monitor-selection.ts
@@ -0,0 +1,12 @@
+import { useAtom } from 'jotai'
+import { selectedMonitorAtom } from '@/contexts/atoms/display-atoms'
+import { trpc } from '@/lib/trpc'
+
+export function useMonitorSelection() {
+  const { data } = trpc.display.known.useQuery(undefined, {refetchInterval: 5000})
+  const [selection, setSelection] = useAtom(selectedMonitorAtom)
+  const displays = data ?? []
+  const selected = selection === '*' ? undefined : displays.find(d => d.name === selection) ?? displays[0]
+  const label = (name: string) => { const index = displays.findIndex(d => d.name === name); return index >= 0 ? `Monitor ${displays[index].number}` : name }
+  return { displays, selection, setSelection, screen: selected?.name, label }
+}
