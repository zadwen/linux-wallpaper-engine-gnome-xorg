+      <option value="">Choose a wallpaper</option>
+      {catalog?.wallpapers.map(wallpaper => <option key={wallpaper.path} value={wallpaper.path}>{wallpaper.title}</option>)}
+    </select></label>}
+    <div className="grid grid-cols-2 gap-4">
+      <label className="space-y-1 text-sm">Frame rate (FPS)<input aria-label="Monitor frame rate" className={field} type="number" min={5} max={360} value={effective.fps} onChange={e => setDraft({...draft, fps: Math.max(5, Math.min(360, Number(e.target.value) || 5))})}/></label>
+      <label className="space-y-1 text-sm">Scaling<select aria-label="Monitor scaling" className={field} value={effective.scaling} onChange={e => setDraft({...draft, scaling: e.target.value as ApplyWallpaperOptions['scaling']})}>{SCALING_OPTIONS.map(option => <option key={option.value} value={option.value}>{option.label}</option>)}</select></label>
+    </div>
+    <label className="block text-sm">Volume: {effective.volume}%<input aria-label="Monitor volume" className="w-full accent-primary" type="range" min={0} max={100} value={effective.volume} onChange={e => setDraft({...draft, volume: Number(e.target.value)})}/></label>
+    <div className="grid grid-cols-2 gap-3 text-sm">{([
+      ['silent', 'Mute wallpaper'], ['noAudioProcessing', 'Disable audio response'], ['disableMouse', 'Disable mouse interaction'],
+      ['disableParallax', 'Disable parallax'], ['disableParticles', 'Disable particles'],
+    ] as const).map(([key, label]) => <label key={key} className="flex items-center gap-2"><input type="checkbox" checked={Boolean(effective[key])} onChange={e => setDraft({...draft, [key]: e.target.checked})}/>{label}</label>)}</div>
+    <fieldset className="space-y-3 border-t border-border pt-4"><legend className="text-sm font-medium">Position and zoom</legend>
+      {([['x', 'Horizontal position', 0, 100], ['y', 'Vertical position', 0, 100], ['zoom', 'Zoom', 100, 300]] as const).map(([key, label, min, max]) => <label key={key} className="block text-sm">{label}: {frame[key]}%<input aria-label={label} className="w-full accent-primary" type="range" min={min} max={max} value={frame[key]} onChange={e => move(key, Number(e.target.value))}/></label>)}
+      <Button variant="outline" size="sm" onClick={() => {const next = {x: 50, y: 50, zoom: 100}; setFraming(next); position.mutate({screen, ...next})}}>Reset position</Button>
+      <p className="text-xs text-muted-foreground">Zoom in to move an image that already fills the screen.</p>
+    </fieldset>
+    {backgroundId && <CustomProperties wallpaperPath={backgroundId} values={effective.customProperties} onChange={value => setDraft({...draft, customProperties: value ?? {}})}/>}
+    <div className="flex flex-wrap gap-3"><Button disabled={!backgroundId || loadingPreferences || apply.isPending} onClick={() => apply.mutate({...effective, windowed: undefined, backgroundId, screen, monitorSpecific: true})}>{apply.isPending ? 'Saving…' : monitor?.connected ? 'Save and apply to this monitor' : 'Save for this monitor'}</Button><Button variant="outline" disabled={!monitor?.connected || !current || stop.isPending} onClick={() => stop.mutate({screen})}>Stop this monitor</Button></div>
+    {message && <p role="status" className="text-sm">{message}</p>}
+  </div>
+}
