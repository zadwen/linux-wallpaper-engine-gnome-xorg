+import { useMonitorSelection } from '@/hooks/use-monitor-selection'
+import { useState } from 'react'
+import type { ApplyWallpaperOptions } from '../../../shared/constants/wallpaper'
+import { SCALING_OPTIONS } from '../../../shared/constants/display'
+import { trpc } from '@/lib/trpc'
+import { Button } from '@/components/ui/button'
+import { CustomProperties } from './details-card/property-settings/custom-properties'
+
+export function MonitorEditor({screen, fixedWallpaper}: {screen: string; fixedWallpaper?: string}) {
+  const utils = trpc.useUtils()
+  const {data: active = []} = trpc.wallpaper.getActiveWallpaper.useQuery(undefined, {refetchInterval: 5000})
+  const {data: catalog} = trpc.wallpaper.getWallpapers.useQuery()
+  const {data: defaults} = trpc.settings.get.useQuery()
+  const {displays} = useMonitorSelection()
+  const monitor = displays.find(display => display.name === screen)
+  const live = active.find(a => a.screen === screen)?.wallpaper
+  const current = monitor?.connected ? live ?? monitor.savedOptions : monitor?.savedOptions ?? live
+  const [chosen, setChosen] = useState('')
+  const backgroundId = fixedWallpaper ?? (chosen || current?.backgroundId || '')
+  const {data: preferences, isLoading: loadingPreferences} = trpc.display.preferences.useQuery({screen, wallpaper: backgroundId})
+  const {data: savedFraming} = trpc.display.framing.useQuery({screen})
+  const [draft, setDraft] = useState<Partial<ApplyWallpaperOptions>>({})
+  const [framing, setFraming] = useState<{x: number; y: number; zoom: number} | null>(null)
+  const [message, setMessage] = useState('')
+  const effective = {
+    fps: defaults?.fps ?? 30, volume: defaults?.volume ?? 0, silent: defaults?.silent ?? true,
+    scaling: defaults?.defaultScaling ?? 'fill', noAutomute: defaults?.noAutomute ?? false,
+    noAudioProcessing: !(defaults?.audioProcessing ?? true), disableMouse: defaults?.disableMouse ?? false,
+    disableParallax: defaults?.disableParallax ?? false, disableParticles: defaults?.disableParticles ?? false,
+    noFullscreenPause: !(defaults?.pauseOnFullscreen ?? true),
+    ...current, ...preferences, ...draft,
+    customProperties: draft.customProperties ?? preferences?.customProperties ?? (current?.backgroundId === backgroundId ? current.customProperties : {}) ?? {},
+  }
+  const apply = trpc.wallpaper.setWallpaper.useMutation({
+    onSuccess: async result => {
+      if (!result.success) { setMessage(result.error ?? 'Could not apply wallpaper'); return }
+      setMessage(result.screens?.length ? `Saved for ${screen}` : `Saved for ${screen}. Connect the monitor and apply, or restart the app to restore it.`)
+      await Promise.all([utils.wallpaper.getActiveWallpaper.invalidate(), utils.display.preferences.invalidate()])
+    }, onError: error => setMessage(error.message),
+  })
+  const stop = trpc.wallpaper.stopWalpaper.useMutation({onSuccess: () => utils.wallpaper.getActiveWallpaper.invalidate()})
+  const position = trpc.display.saveFraming.useMutation({onError: error => setMessage(error.message)})
+  const frame = framing ?? savedFraming ?? {x: 50, y: 50, zoom: 100}
+  function move(key: 'x' | 'y' | 'zoom', value: number) {
+    const next = {...frame, [key]: value}; setFraming(next); position.mutate({screen, ...next})
+  }
+  const field = 'w-full rounded border border-border bg-background p-2'
+  return <div className="space-y-5 rounded-xl border border-border bg-card/90 p-5">
+    <div><h2 className="font-semibold">Customize this monitor</h2><p className="text-sm text-muted-foreground">Changes here apply only to {screen}. Position and zoom update live.</p></div>
