+import { Monitor } from 'lucide-react'
+import { Link } from '@tanstack/react-router'
+import { useMonitorSelection } from '@/hooks/use-monitor-selection'
+import { trpc } from '@/lib/trpc'
+import { cn } from '@/lib/utils'
+
+export function MonitorSelector() {
+  const {displays, screen, selection, setSelection, label} = useMonitorSelection()
+  const {data: active = []} = trpc.wallpaper.getActiveWallpaper.useQuery(undefined, {refetchInterval: 5000})
+  if (!displays.length) return null
+  return <section aria-label="Select monitor" className="flex shrink-0 items-center gap-3 overflow-x-auto border-b border-border bg-background/90 px-[2.5%] py-3">
+    {displays.map(display => <button key={display.name} onClick={() => setSelection(display.name)}
+      aria-pressed={screen === display.name} className={cn('flex min-w-40 items-center gap-3 rounded-lg border px-4 py-3 text-left transition-colors', screen === display.name ? 'border-primary bg-primary/10' : 'border-border hover:bg-secondary')}>
+      <span className="relative"><Monitor className="size-9"/><span className="absolute inset-x-0 top-0.5 text-center text-xs font-bold">{label(display.name).split(' ')[1]}</span></span>
+      <span><strong className="block text-sm">{label(display.name)}</strong><span className="block text-xs text-muted-foreground">{display.name} · {display.connected ? display.resolution : 'Disconnected'}</span>
+      <span className="block max-w-44 truncate text-xs text-muted-foreground">{active.find(a => a.screen === display.name)?.title ?? (display.connected ? 'No wallpaper' : 'Settings saved')}</span></span>
+    </button>)}
+    <button className={cn('rounded-lg border px-3 py-2 text-sm whitespace-nowrap', selection === '*' ? 'border-primary bg-primary/10' : 'border-border')} onClick={() => setSelection('*')}>All connected monitors</button>
+    <Link to="/displays" className="ml-auto whitespace-nowrap text-sm font-medium text-primary underline">Customize {screen ? label(screen) : 'monitors'}</Link>
+  </section>
+}
